      "MNGVYSBBZ25T": {
        "LV_EVENT_SCREEN_LOADED": {
          "start_animation": {
            "type": "start_animation",
            "name": "start",
            "id": "start_animation",
            "anim": {
              "anim_MPGKG8CJ6OMY": {
                "anim_t_MPGKFS9CDYX9": [
                  "x"
                ]
              }
            }
          },
          "custom_code": {
            "type": "custom_code",
            "name": "custom_code",
            "id": "custom_code",
            "include": " #include \"custom.h\"\r\n \r\n extern bool AclockisValid;\r\n extern int AClock_Hour_Value;\r\n extern int AClock_Min_Value;\r\n extern int AClock_Sec_Value;",
            "code": "if (!AclockisValid) {\r\n    lv_anim_t anim_needle;\r\n    lv_anim_init(&anim_needle);\r\n    lv_anim_set_duration(&anim_needle, 800);\r\n    lv_anim_set_delay(&anim_needle, 100);\r\n    lv_anim_set_path_cb(&anim_needle, lv_anim_path_ease_in_out);\r\n    lv_anim_set_repeat_count(&anim_needle, 0);\r\n    lv_anim_set_exec_cb(&anim_needle, (lv_anim_exec_xcb_t)lv_image_set_rotation);\r\n\r\n    lv_anim_set_var(&anim_needle, ui->home_analog.img_Sec);\r\n    lv_anim_set_values(&anim_needle, 0, (AClock_Sec_Value * 6));\r\n    lv_anim_start(&anim_needle);\r\n\r\n    lv_anim_set_var(&anim_needle, ui->home_analog.img_Min);\r\n    lv_anim_set_values(&anim_needle, 0, (AClock_Min_Value * 60));\r\n    lv_anim_start(&anim_needle);\r\n\r\n    lv_anim_set_var(&anim_needle, ui->home_analog.img_Hour);\r\n    lv_anim_set_values(&anim_needle, 0, (AClock_Hour_Value * 300));\r\n    lv_anim_set_completed_cb(&anim_needle, analog_clock_ready_cb);\r\n    lv_anim_start(&anim_needle);\r\n}\r\n"
          }
        },
        "LV_EVENT_SCREEN_UNLOADED": {
          "custom_code": {
            "type": "custom_code",
            "name": "custom_code",
            "id": "custom_code",
            "include": "",
            "code": "AclockisValid = false;\r\nlv_image_set_rotation(ui->home_analog.img_Sec, 0);\r\nlv_image_set_rotation(ui->home_analog.img_Min, 0);\r\nlv_image_set_rotation(ui->home_analog.img_Hour, 0);"
          },
